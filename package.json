{
  "name": "harnesslab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "check:secrets": "node scripts/check-client-bundle.mjs",
    "experiment:smoke": "node --conditions=react-server --env-file=.env.local --import tsx scripts/experiment-smoke.ts",
    "experiment:compare": "node --conditions=react-server --env-file=.env.local --import tsx scripts/experiment-compare.ts",
    "experiment:interaction": "node --conditions=react-server --env-file=.env.local --import tsx scripts/experiment-interaction.ts",
    "experiment:skill-context": "node --conditions=react-server --env-file=.env.local --import tsx scripts/experiment-skill-context.ts",
    "diagnose:smoke": "node --conditions=react-server --env-file=.env.local --import tsx scripts/diagnose-smoke.ts",
    "diagnose:adaptive": "node --conditions=react-server --env-file=.env.local --import tsx scripts/diagnose-adaptive.ts",
    "diagnose:stable": "node --conditions=react-server --env-file=.env.local --import tsx scripts/diagnose-stable.ts",
    "diagnose:stable-simulate": "node --conditions=react-server --import tsx scripts/diagnose-stable-simulate.ts",
    "sandbox:smoke": "node --env-file=.env.local scripts/sandbox-smoke.mjs",
    "sandbox:branch-spike": "node --env-file=.env.local scripts/sandbox-branch-spike.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}

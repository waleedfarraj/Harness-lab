# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Server-side only: do NOT rename any of these with a NEXT_PUBLIC_ prefix.

# Required. Create one at https://tokenfactory.nebius.com (API keys section).
NEBIUS_API_KEY=

# Optional. OpenAI-compatible Token Factory endpoint.
# Default: https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1

# Optional. Any NVIDIA Nemotron model ID enabled for your account.
# Default: nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional. Request timeout in milliseconds. Default: 60000
NEBIUS_TIMEOUT_MS=

# Required only for HARNESSLAB_RUNNER=token-factory (Token Factory Sandboxes beta).
# Your Nebius project id, from the Nebius console. Control-plane only: read by the
# Python Contree bridge process to authenticate; never passed into sandbox commands.
NEBIUS_PROJECT_ID=

# Optional. Which experiment runner to use: "local" (default) or "token-factory".
# token-factory requires NEBIUS_PROJECT_ID and a working `python3 -m pip install
# -r requirements-sandbox.txt`. There is no silent fallback: if token-factory is
# selected and unavailable/misconfigured, experiments fail with a clear error.
HARNESSLAB_RUNNER=local
